#!/usr/bin/env bash
set -euo pipefail
module_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
jar="${DTS_PACK_CLI_JAR:-$module_dir/target/dts-common-pack-1.0.0-cli.jar}"
if [[ ! -f "$jar" ]]; then echo 'Build dts-common first: ./build.sh package' >&2; exit 1; fi
exec "${JAVA:-java}" -jar "$jar" "$@"
