{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzhicloud.com/schemas/wiki-content/v1/space-manifest",
  "title": "DTS Wiki space manifest (spaces.yml)",
  "description": "Declares the wiki spaces of a content repository. Roots are paths relative to the repository root.",
  "type": "object",
  "required": ["version", "spaces"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "spaces": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["slug", "name", "roots", "role"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "maxLength": 500 },
          "roots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$", "maxLength": 300 }
          },
          "role": { "type": "string", "pattern": "^space-[a-z][a-z0-9-]{1,31}$" }
        }
      }
    }
  }
}
