# Rendered by install.sh; do not edit harbor.yml directly.
hostname: ${HARBOR_HOST}
http:
  port: ${HARBOR_HTTP_PORT}
https:
  port: ${HARBOR_HTTPS_PORT}
  certificate: ${HARBOR_ROOT}/deploy/certs/server.crt
  private_key: ${HARBOR_ROOT}/deploy/certs/server.key
external_url: https://${HARBOR_HOST}:${HARBOR_HTTPS_PORT}
harbor_admin_password: ${HARBOR_ADMIN_PASSWORD}
database:
  password: ${HARBOR_DB_PASSWORD}
  max_idle_conns: 20
  max_open_conns: 100
  conn_max_lifetime: 5m
  conn_max_idle_time: 0
data_volume: ${HARBOR_ROOT}/data
# Trivy is not installed yet (.50 cannot reach ghcr.io); kept offline-ready for later.
trivy:
  ignore_unfixed: false
  skip_update: true
  skip_java_db_update: true
  offline_scan: true
  security_check: vuln
  insecure: false
  timeout: 5m0s
jobservice:
  max_job_workers: 4
  max_job_duration_hours: 24
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1
notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3
log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: ${HARBOR_ROOT}/log
_version: 2.15.0
proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false
cache:
  enabled: false
  expire_hours: 24
