# wiki-api: page editing, image upload, git sync and site build/publish.
# Build context: wiki/server
FROM node:24-alpine
RUN apk add --no-cache git openssh-client tzdata \
 && npm config set registry https://registry.npmmirror.com -g
WORKDIR /app
COPY *.mjs ./
RUN rm -f *.test.mjs
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node", "/app/main.mjs"]
